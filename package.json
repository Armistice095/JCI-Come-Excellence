{
  "name": "jci-come-excellence",
  "version": "1.0.0",
  "description": "Site officiel de JCI Comé Excellence",
  "scripts": {
    "dev": "tailwindcss -i ./css/tailwind-input.css -o ./css/output.css --watch",
    "serve": "npm run build && npx serve dist",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/output.css --minify",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.0.0"
  }
}
